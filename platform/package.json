{
  "name": "steadyline-care",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Care operations API: patients, home and clinic visits, deliveries, dispatch, vitals alerts, audit.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "leaflet": "^1.9.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
